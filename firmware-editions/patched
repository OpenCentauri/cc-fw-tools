###
### This is the configuration for OpenCentauri Firmware
###
### You can edit variables in here to tweak settings in the FW!
###

KIP_BOOTSTRAP_URL='https://github.com/pdscomp/Kipware/releases/download/2026-06-20/kipware-cc1-2026-06-20.tar.gz'
KIP_BOOTSTRAP_PATH='./app/kipware.tar.gz'
KIP_BOOTSTRAP_SHA256=031132eb441845836151fb9d65b81bf8d667bff79fc00f97288bebb940e92667

# How long to wait until starting /app/app on boot
# If non-zero, you can SSH in after boot and run 'noapp' to prevent start
OC_APP_BOOT_DELAY=0

# Default NTP Server
OC_NTP_SERVER=pool.ntp.org

# If this file exists, then auto noapp on boot
# Designed to allow for a Raspberry Pi in gadget mode to plug in!
OC_APP_GADGET=/dev/ttyACM0

HOME_POSITION_FRONT_RIGHT=true
REPLACE_BOOTLOGO=true
BLOCK_UPDATE_CHECK=true
#API_DURING_PRINTING=true
API_DURING_PRINTING=false
#ADD_CHAMBER_LIGHT_GCODE=true
ADD_CHAMBER_LIGHT_GCODE=false
#BLOCK_CONNECTIVITY_CHECK=true
BLOCK_CONNECTIVITY_CHECK=false
#DISABLE_EXHAUST_FAN=true
DISABLE_EXHAUST_FAN=false
#SET_FIRMWARE_VERSION=true
SET_FIRMWARE_VERSION=false
#ALWAYS_ALLOW_Z_OFFSET_ADJUST=true
ALWAYS_ALLOW_Z_OFFSET_ADJUST=false
#WAIT_FOR_CHAMBER_TEMP=true
WAIT_FOR_CHAMBER_TEMP=false
#REPORT_FILAMENT_USAGE=true
REPORT_FILAMENT_USAGE=false
#FIX_NONCANVAS_LOAD=true
FIX_NONCANVAS_LOAD=false
#FIX_SINGLECOLOR_FILAMENT_SELECTION=true
FIX_SINGLECOLOR_FILAMENT_SELECTION=false
#OTA_UPDATES=true
OTA_UPDATES=false
#UPLOAD_DURING_PRINTING=true
UPLOAD_DURING_PRINTING=false
UBOOT=true
UART=true
MISC_APP=true
