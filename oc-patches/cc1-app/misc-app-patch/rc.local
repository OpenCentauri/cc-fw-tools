if [ -e /app/noapp.kill ]; then
  echo "Kill file noapp.kill present! Continuing boot without /app/app..."
  rm -f /app/noapp.kill 2>/dev/null
  echo "/app/noapp.kill deleted."
  exit 0
fi

# Migrate calibration settings from old printer.cfg into new factory config
if [ -f /app/update-printer-cfg.py ]; then
    python3 /app/update-printer-cfg.py
fi
