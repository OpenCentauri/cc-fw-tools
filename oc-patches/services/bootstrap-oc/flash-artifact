#!/usr/bin/env python3

import sys, os, subprocess, re

REPO = "OpenCentauri/cc-fw-tools"
ARTIFACT_NAME = "CC1 Firmware"
ARTIFACT_ZIP = "CC1%20Firmware.zip"


def transform_url(url: str) -> str:
    """Accept either a GitHub Actions run URL or a nightly.link URL."""
    url = url.strip()

    # Already a nightly.link URL
    if url.startswith("https://nightly.link/"):
        return url

    # GitHub Actions run URL
    m = re.match(rf"https://github\.com/{re.escape(REPO)}/actions/runs/(\d+)", url)
    if m:
        run_id = m.group(1)
        return f"https://nightly.link/{REPO}/actions/runs/{run_id}/{ARTIFACT_ZIP}"

    raise ValueError(f"Unsupported URL format: {url}")


def main():
    if len(sys.argv) != 2:
        print("Usage: flash-artifact <github-actions-run-url | nightly.link-url>")
        sys.exit(1)

    url = sys.argv[1]
    fw_url = transform_url(url)

    tmp_dir = "/user-resource/.tmp"
    os.makedirs(tmp_dir, exist_ok=True)
    os.chdir(tmp_dir)

    zip_name = "artifact.zip"
    swu_name = "update.swu"

    print(f"Downloading artifact from {fw_url} ...")
    subprocess.run(["curl", "-L", "-f", "-o", zip_name, fw_url], check=True)

    print(f"Unpacking {zip_name} ...")
    subprocess.run(["unzip", "-o", zip_name], check=True)

    # The artifact zip may contain nested directories; find the actual .swu
    swu_path = None
    if os.path.isfile(swu_name):
        swu_path = f"./{swu_name}"
    else:
        for root, _dirs, files in os.walk("."):
            for f in files:
                if f.endswith(".swu"):
                    swu_path = os.path.join(root, f)
                    break
            if swu_path:
                break

    if not swu_path:
        print("Error: no .swu file found inside the artifact", file=sys.stderr)
        sys.exit(1)

    print(f"Found firmware image: {swu_path}")
    print("Installing firmware...")
    subprocess.run(["flash", swu_path], check=True)

    print("Cleaning up...")
    try:
        os.remove(zip_name)
        os.remove(swu_path)
    except FileNotFoundError:
        pass

    print("Rebooting...")
    subprocess.run(["reboot"], check=True)


if __name__ == "__main__":
    main()
