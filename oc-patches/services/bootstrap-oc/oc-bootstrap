#!/bin/sh /etc/rc.common

START=81

boot() {
    # Wait for the user-resource mount to be available, which is where we will store entware and the root homedir
    i=0; while ! grep -qs '/user-resource' /proc/mounts && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
    
    # INITIALIZE OpenCentauri and entware
    mkdir -p /user-resource/.root \
             /user-resource/.kipware \
             /kip /opt /root
    # Old Entware deprecated
    #mount -o bind /user-resource/OpenCentauri/entware /opt
    mount -o bind /user-resource/.kipware /kip
    mount -o bind /user-resource/.root /root
    # Bootstrap kipware if needed!
    if [ ! -f /kip/etc/entware_release ]; then
    cd / &&
        tar zxvf /app/kipware.tar.gz user-resource
        echo 'Entware is now Kipware, and lives in /kip! Now with more Mudkips...' > /opt/Kipware-Info.txt
    fi
    # Bootstrap root homedir if needed!
    if [ ! -f /root/.profile ]; then
        echo '[ -x /kip/bin/bash ] && exec /kip/bin/bash -l' > /root/.profile
    fi
    if [ ! -f /root/.bash_profile ]; then
        echo '. /kip/profile-kipware.sh' > /root/.bash_profile
    fi
    # Create symlink to old root homedir if exists
    if [ -d /user-resource/OpenCentauri/root ]; then
        ln -sf /user-resource/OpenCentauri/root /root/legacy-root-homedir
    fi
    # Once entware is properly installed, do the things!
    if [ -f /kip/etc/entware_release ]; then
        # Add entware to path for rest of rc.local execution
        export PATH="/kip/sbin:/kip/bin:$PATH"

        # Mount the USB FAT/exFAT drive if available or if it becomes available
        mount_usb_daemon &

        # Generate openssh host keys in /kip/etc/ssh (if needed, else it skips)
        ssh-keygen -A

        # Enable root login if this is the first boot after installing Kipware
        sed -re 's/^#PermitRootLogin.*/PermitRootLogin yes/' -i /kip/etc/ssh/sshd_config

        # Start entware system services, includes openssh
        /kip/etc/init.d/rc.unslung start

        # Start wlan0 interface if available
        /app/oc-startwifi.sh &
        sleep 2

        # Start DHCPD for usb0 network interface if available! If not then don't try.
        ifconfig usb0 && udhcpc -i usb0 -f -p /tmp/usb0_udhcpc.pid \
                                -s /usr/share/udhcpc/default.script \
                                -x hostname:Centauri-Carbon \
                                -A 5 -t 10 -T 3 &
        #ifconfig usb0 && udhcpc -i usb0 -b -p /tmp/usb0_udhcpc.pid -s /usr/share/udhcpc/default.script -x hostname:Centauri-Carbon &

        # Load Realtek/ASIX kmods and start DHCP client for eth0 network interface if available! If not then don't try.
        modprobe r8152
        modprobe ax88179_178a
        sleep 2

        ifconfig eth0 && udhcpc -i eth0 -f -p /tmp/eth0_udhcpc.pid \
                                -s /usr/share/udhcpc/default.script \
                                -x hostname:Centauri-Carbon \
                                -A 5 -t 10 -T 3 &
        #ifconfig eth0 && udhcpc -i eth0 -b -p /tmp/eth0_udhcpc.pid -s /usr/share/udhcpc/default.script -x hostname:Centauri-Carbon &

        # Force a DHCP renewal in udhcpc every 6 hours as a safety net, reasoning:
        # BusyBox v1.27.2 (TinaLinux version) has a documented issue where udhcpc 
        # waits until the last 60 seconds of a lease before broadcasting a
        # DHCPREQUEST renewal. If the DHCP server is even slightly busy or udhcpc
        # drifts timing-wise, it can miss the window entirely and let the lease
        # expire, sometimes causing the daemon to stall or exit.
        sh -c "while [ 1 ]; do sleep 21616; killall -USR1 udhcpc; done" &

        # Update mlocate db now, and every 24 hours!
        sh -c "while [ 1 ]; do updatedb; sleep 86400; done" &

        # Synchronize time to NTP, and every 24 hours!
        # Backgrounded so boot() can return; sleeps first so WiFi/DHCP wins the race.
        # Cap the initial retry burst so an air-gapped or offline device does not hammer
        # pool.ntp.org forever; the next 24-hour cycle will try again.
        sh -c 'sleep 30
            while true; do
                n=0
                until /usr/sbin/ntpdate -u pool.ntp.org >/tmp/ntpdate.log 2>&1 || [ "$n" -ge 60 ]; do
                    n=$((n+1))
                    sleep 5
                done
                sleep 86400
            done' &

    fi
}
